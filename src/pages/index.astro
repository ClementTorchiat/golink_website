---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/global/Header.astro';
import BentoGrid from '../components/ui/BentoGrid.astro';
import BentoItem from '../components/ui/BentoItem.astro';
import IconText from '../components/ui/IconText.astro';
import TargetCard from '../components/ui/TargetCard.astro';
import Button from '../components/global/Button.astro';
---

<MainLayout title="GOLink - Le bus modulaire">
    <Header slot="header" />
    <section class="hero-section">
        <div class="hero-container">
            <div class="hero-content">
                <div class="text-block">
                    <h1>GOLink<br>Le bus de demain.</h1>
                    <p>Le concept de bus modulaire optimisé pour les villes intelligentes.</p>
                </div>

                <div class="image-block">
                    <div class="image-placeholder">
                        BUS MODULE MOCKUP
                    </div>
                </div>
            </div>

        </div>
    </section>
    <section class="short-section">
        <p class="short-text">Découvrez GoLink : le bus urbain autonome, 100 % électrique et modulable. Disponible 24h/24, il ajuste sa taille en temps réel selon l'affluence pour mettre fin aux trajets à vide. Une mobilité sur-mesure, écologique et toujours à votre service.</p>
    </section>

    <section class="benefits-section">
        <div class="section-header">
            <h2>Bénéfices clés</h2>
        </div>

        <BentoGrid>
            <BentoItem col={6} accent="yellow">
                <IconText
                        title="Optimise les trajets"
                        description="La diminution des trajets inutiles et des détours assure un service plus rapide et fluide. Les demandes proches sont intelligemment regroupées pour réduire significativement le trafic urbain.">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                    </svg>
                </IconText>
            </BentoItem>

            <BentoItem col={6} accent="purple">
                <IconText
                        title="Plus de place quand nécessaire"
                        description="En cas de forte affluence, des modules supplémentaires viennent s'accrocher à la structure. La capacité d'accueil augmente ainsi instantanément, à la manière de wagons, pour transporter davantage de passagers.">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                    </svg>
                </IconText>
            </BentoItem>

            <BentoItem col={6} accent="lightblue">
                <IconText
                        title="Adapté à la demande"
                        description="Un service flexible et disponible 24h/24, pensé pour répondre efficacement aux besoins réels des usagers. Le réseau s'ajuste en temps réel et permet de desservir même les zones habituellement difficiles d'accès.">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </IconText>
            </BentoItem>

            <BentoItem col={6} accent="darkblue">
                <IconText
                        title="Écologique"
                        description="Ce système 100 % électrique réduit les émissions de CO2 en évitant la circulation de bus à moitié vides. Une solution durable qui améliore concrètement la qualité de l'air en milieu urbain.">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                </IconText>
            </BentoItem>
        </BentoGrid>
    </section>

    <section class="target-section">
        <div class="section-header">
            <h2>Pour qui ?</h2>
        </div>

        <BentoGrid>
            <TargetCard
                    title="Habitants"
                    color="lightblue"
                    imageUrl="/images/habitants.jpg"
                    description="Profitez d'un service continu, idéal pour vos trajets nocturnes ou dans les quartiers habituellement peu desservis. Renseignez vos déplacements occasionnels la veille pour vous garantir un bus prêt à l'heure prévue."
            />

            <TargetCard
                    title="Étudiants"
                    color="yellow"
                    imageUrl="/images/etudiants.jpg"
                    description="Gagnez du temps au quotidien en renseignant votre emploi du temps hebdomadaire une seule fois dans l'application. Le système anticipe votre routine et vous oriente chaque jour vers le lieu d'attente optimal."
            />

            <TargetCard
                    title="Touristes"
                    color="purple"
                    imageUrl="/images/touristes.jpg"
                    description="Explorez la ville librement et sans aucune planification préalable. Indiquez votre destination au moment où vous en avez besoin et laissez-vous guider intuitivement grâce à notre interface multilingue."
            />
        </BentoGrid>
    </section>

    <section class="assembly-section">
        <div class="assembly-container" id="assembly-trigger">

            <div class="module-card module-left">
                <h3>Comment ça marche ?</h3>
                <p>Découvrez la technologie derrière nos bus modulaires et comment ils s'adaptent au trafic en temps réel.</p>
                <div class="btn-wrapper">
                    <Button href="/fonctionnement" variant="primary">Le fonctionnement</Button>
                </div>
            </div>

            <div class="sparks">
                <svg viewBox="0 0 24 24" fill="#FFEC83" stroke="#283276" stroke-width="1.5" stroke-linejoin="round"> <path d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                <svg viewBox="0 0 24 24" fill="#FFEC83" stroke="#283276" stroke-width="1.5" stroke-linejoin="round"> <path d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                <svg viewBox="0 0 24 24" fill="#FFEC83" stroke="#283276" stroke-width="1.5" stroke-linejoin="round"> <path d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                <svg viewBox="0 0 24 24" fill="#FFEC83" stroke="#283276" stroke-width="1.5" stroke-linejoin="round"> <path d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                <svg viewBox="0 0 24 24" fill="#FFEC83" stroke="#283276" stroke-width="1.5" stroke-linejoin="round"> <path d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>

            <div class="module-card module-right">
                <h3>Pourquoi GOLink ?</h3>
                <p>Écologique, économique et pensé pour les usagers. Explorez tous les bénéfices de notre solution pour la ville.</p>
                <div class="btn-wrapper">
                    <Button href="/avantages" variant="accent">Les avantages</Button>
                </div>
            </div>

        </div>
    </section>

</MainLayout>

<style>
    .hero-section {
        padding: 10px; /* Ta demande */
        width: 100vw;
        /* On force la page à au moins remplir l'écran pour le hero */
        min-height: 100vh;
    }

    .hero-container {
        background-color: #ffffff; /* Ton bleu foncé principal, monotone */
        color: #000000;
        height: calc(100vh - 20px); /* 100vh moins padding haut/bas de 10px */
        border-radius: 18px; /* Standard 18px */
        overflow: hidden;
        position: relative;
        display: flex;
        align-items: flex-end; /* Texte en bas comme Worklouder */
        padding: 40px; /* Espacement interne compact */
        border: 1px solid rgba(40, 50, 118, 0.08);
    }

    .hero-content {
        width: 100%;
        max-width: 1380px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px; /* Gap compact */
        align-items: flex-end;
    }

    .text-block {
        max-width: 500px;
    }

    h1 {
        font-size: 3.5rem;
        margin: 0 0 10px 0;
        line-height: 1.1;
        letter-spacing: -0.05em;
    }

    p {
        font-size: 1.1rem;
        color: rgba(0, 0, 0, 0.8);
        margin: 0;
        line-height: 1.4;
    }

    .image-placeholder {
        background-color: rgba(255, 255, 255, 0.05); /* Monotone technique */
        border: 1px solid rgba(255, 255, 255, 0.1);
        height: 300px;
        border-radius: 18px; /* Standard 18px */
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.3);
        font-weight: bold;
    }

    .short-section {
        background-color: white;
        padding-top: 48px;
        padding-bottom: 48px;
        border-radius: 18px;
        margin: 0 10px 64px;
        border: 1px solid rgba(40, 50, 118, 0.08);
    }

    .short-text {
        font-size: 1.1rem;
        color: #000000;
        width: 40%;
        text-align: center;
        margin: auto;
    }
    /* Dans la balise <style> de index.astro */
    .benefits-section {
        width: 100vw; /* Prend tout l'écran */
        padding: 0 10px; /* Aligne les boîtes exactement comme le hero */
        margin-bottom: 64px;
    }

    .section-header {
        margin-bottom: 24px;
        padding-left: 10px; /* Petit espace pour aligner le titre H2 avec le texte du Hero */
    }

    .section-header h2 {
        font-size: 2rem;
        margin: 0;
        color: #283276;
        letter-spacing: -0.03em;
    }

    .target-section {
        width: 100vw;
        padding: 0 10px;
        margin-bottom: 10px;
    }

    /* --- SECTION ASSEMBLAGE --- */
    .assembly-section {
        width: 100vw;
        padding: 0 10px;
        margin-bottom: 10px; /* BOOM ! Plus que 10px avant le footer */
        overflow-x: hidden;
    }

    .assembly-container {
        width: 100%; /* <-- MODIFIÉ : Remplace le max-width par 100% */
        display: flex;
        align-items: stretch;
        gap: 60px;
        position: relative;
    }

    /* Le style Bento des deux modules */
    .module-card {
        flex: 1;
        background-color: #ffffff;
        border: 1px solid rgba(40, 50, 118, 0.08);
        border-radius: 18px;
        padding: 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 16px;

        /* État de départ pour l'animation (Invisible et décalé) */
        opacity: 0;
        transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.8s ease;
    }

    .module-left { transform: translateX(-100px); }
    .module-right { transform: translateX(100px); }

    .module-card h3 { margin: 0; font-size: 1.8rem; color: #283276; }
    .module-card p { margin: 0; font-size: 1rem; color: rgba(40, 50, 118, 0.7); line-height: 1.5; }
    .btn-wrapper { margin-top: 8px; }

    /* L'étincelle au centre */
    .sparks {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%) scale(0);
        display: flex;
        flex-direction: column;
        gap: 6px; /* <-- MODIFIÉ : Un peu plus serré pour 5 éclairs */
        z-index: 10;
        opacity: 0;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.5s, opacity 0.4s ease 0.5s;
    }

    .sparks svg {
        width: 28px;
        height: 28px;
        /* --- AJOUT : Rotation de 90deg vers la droite --- */
        transform: rotate(90deg);
    }

    /* --- LES ÉTATS ACTIFS (Quand l'utilisateur scrolle sur la section) --- */
    .assembly-container.is-assembled .module-card {
        transform: translateX(0); /* Ils viennent se coller à leur place */
        opacity: 1;
    }

    .assembly-container.is-assembled .sparks {
        transform: translate(-50%, -50%) scale(1); /* L'éclair pop au milieu ! */
        opacity: 1;
    }

    /* Responsive (sur mobile, ça s'assemble du haut vers le bas) */
    @media (max-width: 768px) {
        .assembly-container { flex-direction: column; gap: 40px; }
        .module-left { transform: translateY(-50px); }
        .module-right { transform: translateY(50px); }
        .assembly-container.is-assembled .module-card { transform: translateY(0); }
        /* L'étincelle pivote pour pointer vers le bas */
        .sparks { transform: translate(-50%, -50%) rotate(90deg) scale(0); }
        .assembly-container.is-assembled .sparks { transform: translate(-50%, -50%) rotate(90deg) scale(1); }
    }
</style>

<script>
    function initAssembly() {
        // On observe le conteneur
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                // Si l'utilisateur scrolle et voit au moins 30% de la section
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-assembled');
                    // On arrête d'observer pour ne jouer l'animation qu'une seule fois
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.3 });

        const container = document.getElementById('assembly-trigger');
        if (container) observer.observe(container);
    }

    // On lance le script au chargement de la page (compatible ViewTransitions)
    document.addEventListener('astro:page-load', initAssembly);
</script>