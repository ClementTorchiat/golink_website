---
// src/pages/fonctionnement.astro
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/global/Header.astro';
import BentoItem from '../components/ui/BentoItem.astro';
import UsageCard from '../components/ui/UsageCard.astro';
---

<MainLayout title="Fonctionnement - GOLink">
    <Header slot="header" />

    <section class="hero-section">
        <div class="hero-container bento-style" id="merging-visual">

            <div class="hero-text">
                <h1>L'assemblage dynamique</h1>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.</p>
            </div>

            <div class="buses-area">
                <div class="module module-left">
                    <img src="/images/high_quality_side.png" alt="Avant du module GOLink gauche" />
                </div>
                <div class="module module-right">
                    <img src="/images/high_quality_side.png" alt="Arrière du module GOLink droite" />
                </div>
            </div>

        </div>
    </section>

    <section class="usage-section">

        <div class="usage-header bento-style">
            <h2>L'adaptabilité à la demande</h2>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
        </div>

        <div class="usage-grid">
            <UsageCard
                    title="Utilisation régulière"
                    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore."
                    modules={1}
            />
            <UsageCard
                    title="Utilisation occasionnelle"
                    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore."
                    modules={3}
            />
            <UsageCard
                    title="Touriste"
                    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore."
                    modules={5}
            />
        </div>
    </section>

    <section class="benefits-section">
        <div class="benefits-row">
            <BentoItem
                    title="Bénéfice 1"
                    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
            />

            <BentoItem
                    title="Bénéfice 2"
                    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
            />

            <BentoItem
                    title="Bénéfice 3"
                    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
            />

            <BentoItem
                    title="Bénéfice 4"
                    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
            />
        </div>
    </section>

</MainLayout>

<script>
    function startMergingAnimation() {
        const container = document.getElementById('merging-visual');
        if (container) {
            setTimeout(() => {
                container.classList.add('is-merged');
            }, 100);
        }
    }
    document.addEventListener('astro:page-load', startMergingAnimation);
</script>

<style>
    :global(body) { background-color: #e8e8e8; margin: 0; padding: 0; }

    .bento-style {
        background-color: #ffffff;
        border-radius: 18px;
        border: 1px solid rgba(40, 50, 118, 0.08);
    }

    /* 🛡️ LE FIX STRUCTUREL 🛡️ */
    .hero-section {
        width: 100vw;
        /* Hauteur exacte : 100% de l'écran - 20px (pour laisser 10px de marge top/bottom) */
        height: calc(100vh - 20px);
        padding: 0 10px;
        margin-top: 10px;
        margin-bottom: 10px; /* Tes 10px du bas sont de retour ! */
        box-sizing: border-box;
    }

    .hero-container {
        width: 100%;
        height: 100%; /* Prend exactement la place de la section */
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* --- TEXTE EN HAUT --- */
    .hero-text {
        text-align: center;
        max-width: 800px;
        z-index: 10;
        margin-top: 8vh;
        margin-bottom: 40px; /* Tu peux changer ça sans rien casser ! */
    }

    .hero-text h1 {
        font-size: 3.5rem;
        color: #283276;
        margin: 0 0 24px 0;
        line-height: 1.1;
        letter-spacing: -0.05em;
    }

    .hero-text p {
        font-size: 1.2rem;
        color: rgba(40, 50, 118, 0.7);
        line-height: 1.5;
        margin: 0;
    }

    /* --- ZONE DES BUS EN BAS --- */
    .buses-area {
        /* 🔴 MAGIE 1 : Flex-grow absorbe tout l'espace libre sans modifier la hauteur du parent */
        flex-grow: 1;
        width: 100%;
        position: relative;
        display: flex;
        align-items: flex-end; /* Colle les bus au fond */
        justify-content: center;

        /* Ajuste ce chiffre entre 12% et 20% pour régler le chevauchement transparent */
        --crop-factor: 15%;
    }

    .module {
        position: absolute;
        bottom: -10%; /* Fait dépasser un peu les roues vers le bas */
        width: 85vw; /* Taille plus raisonnable */
        max-width: 1600px;
        min-width: 1000px;
    }

    .module img {
        width: 100%;
        height: auto;
        display: block;
    }

    /* --- MODULE DE DROITE (Devant) --- */
    .module-right {
        left: 50%;
        /* 🔴 MAGIE 2 : Les % dans un transform utilisent la largeur de l'image, c'est infaillible ! */
        transform: translateX(calc(-1 * var(--crop-factor)));
        z-index: 2; /* Force absolue pour qu'il soit DEVANT */
    }

    /* --- MODULE DE GAUCHE (S'accroche derrière) --- */
    .module-left {
        right: 50%;
        transform: translateX(-100vw); /* Part de tout à gauche */
        opacity: 0;
        transition: transform 1.5s cubic-bezier(0.23, 1, 0.32, 1), opacity 1s ease;
        z-index: 1; /* Force absolue pour qu'il glisse DERRIÈRE */
    }

    .hero-container.is-merged .module-left {
        /* Vient percuter la ligne avec le même calcul */
        transform: translateX(var(--crop-factor));
        opacity: 1;
    }

    @media (max-width: 768px) {
        .hero-text h1 { font-size: 2.5rem; }
        .module { width: 140vw; min-width: 800px; bottom: 0; }
    }

    /* --- SECTION 2 : USAGE --- */
    .usage-section {
        width: 100vw;
        padding: 0 10px;
        margin-bottom: 10px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 10px; /* L'espacement strict de 10px entre l'en-tête et les 3 cartes */
    }

    .usage-header {
        text-align: center;
        /* Les propriétés padding, bg et border sont gérées par .bento-style */
    }

    .usage-header h2 {
        font-size: 2.5rem;
        color: #283276;
        margin: 0 0 16px 0;
        letter-spacing: -0.03em;
    }

    .usage-header p {
        font-size: 1.15rem;
        color: rgba(40, 50, 118, 0.7);
        max-width: 800px;
        margin: 0 auto;
        line-height: 1.5;
    }

    .usage-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        width: 100%;
    }

    /* --- SECTION 3 : BÉNÉFICES 1x4 --- */
    .benefits-section {
        width: 100vw;
        padding: 0 10px; /* Les 10px sur les côtés */
        margin-bottom: 10px; /* Les 10px en bas (avant le footer) */
        box-sizing: border-box;
    }

    .benefits-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr); /* Force 4 colonnes sur une seule ligne */
        gap: 10px; /* L'espacement strict de 10px entre chaque carte */
        width: 100%;
    }

    /* Responsive Design pour que ça reste lisible sur petits écrans */
    @media (max-width: 1024px) {
        .benefits-row { grid-template-columns: repeat(2, 1fr); } /* Repasse en 2x2 sur tablette */
    }

    @media (max-width: 768px) {
        .benefits-row { grid-template-columns: 1fr; } /* 1 colonne sur mobile */
    }
</style>