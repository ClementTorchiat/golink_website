---
// src/pages/fonctionnement.astro
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/global/Header.astro';
import BentoGrid from '../components/ui/BentoGrid.astro';
import TargetCard from '../components/ui/TargetCard.astro';
import Button from '../components/global/Button.astro';
import BentoItem from '../components/ui/BentoItem.astro';
import IconText from '../components/ui/IconText.astro';
---

<MainLayout title="Fonctionnement - GOLink">
    <Header slot="header" />

    <section class="hero-section">
        <div class="hero-container bento-style" id="merging-visual">

            <div class="hero-text">
                <h1>L'assemblage dynamique</h1>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.</p>
            </div>

            <div class="buses-area">
                <div class="module module-left">
                    <img src="/images/profil_sans_perspective.png" alt="Module GOLink gauche" />
                </div>
                <div class="module module-right">
                    <img src="/images/profil_sans_perspective.png" alt="Module GOLink droite" />
                </div>
            </div>

        </div>
    </section>

    <section class="modules-presentation-section">
        <div class="modules-bento bento-style">

            <div class="modules-text">
                <h2>Lorem ipsum</h2>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
            </div>

            <div class="modules-list">
                <div class="module-type">
                    <span class="module-name">Type de bus 1</span>
                    <span class="module-detail">Petite capacité</span>
                </div>
                <div class="module-type">
                    <span class="module-name">Type de bus 2</span>
                    <span class="module-detail">Moyenne capacité</span>
                </div>
                <div class="module-type">
                    <span class="module-name">Type de bus 3</span>
                    <span class="module-detail">Grande capacité</span>
                </div>
                <div class="module-type">
                    <span class="module-name">Type de bus 4</span>
                    <span class="module-detail">Capacité maximale</span>
                </div>
            </div>

        </div>
    </section>

    <section class="needs-section">

        <div class="needs-header bento-style">
            <h2>Adapté aux besoins</h2>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
        </div>

        <BentoGrid>
            <TargetCard
                    title="Utilisation régulière"
                    color="lightblue"
                    imageUrl="/images/habitants.jpg"
                    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam."
            />

            <TargetCard
                    title="Utilisation occasionnelle"
                    color="yellow"
                    imageUrl="/images/etudiants.jpg"
                    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam."
            />

            <TargetCard
                    title="Touriste"
                    color="purple"
                    imageUrl="/images/touristes.jpg"
                    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam."
            />
        </BentoGrid>
    </section>

    <section class="app-section">
        <div class="app-bento bento-style">

            <div class="app-mockup-block">
                <div class="phone-skeleton">

                    <div class="phone-screen">
                        <img src="/images/app-screen-1.png" alt="Interface GOLink 1" class="screen-image is-active" id="screen-1" />
                        <img src="/images/app-screen-2.png" alt="Interface GOLink 2" class="screen-image" id="screen-2" />
                        <img src="/images/app-screen-3.png" alt="Interface GOLink 3" class="screen-image" id="screen-3" />
                    </div>

                    <div class="phone-btn phone-btn-volume"></div>
                    <div class="phone-btn phone-btn-power"></div>
                </div>
            </div>

            <div class="app-text-block">
                <h2>L'application</h2>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
                <div class="btn-wrapper">
                    <Button href="#" variant="primary">Télécharger l'app</Button>
                </div>
            </div>

        </div>
    </section>

    <section class="horizontal-benefits-section">
        <div class="horizontal-benefits-grid">

            <BentoItem col={3} accent="lightblue">
                <IconText title="Estimation de l'affluence">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </IconText>
            </BentoItem>

            <BentoItem col={3} accent="yellow">
                <IconText title="Ajustement des trajets">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                    </svg>
                </IconText>
            </BentoItem>

            <BentoItem col={3} accent="purple">
                <IconText title="Dispatch intelligent des bus">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                    </svg>
                </IconText>
            </BentoItem>

            <BentoItem col={3} accent="darkblue">
                <IconText title="Points d'attente dynamiques">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                </IconText>
            </BentoItem>

        </div>
    </section>
</MainLayout>

<script>
    function startMergingAnimation() {
        const container = document.getElementById('merging-visual');
        if (container) {
            setTimeout(() => {
                container.classList.add('is-merged');
            }, 100);
        }
    }
    document.addEventListener('astro:page-load', startMergingAnimation);

    // --- SCRIPT ROTATION ÉCRAN APPLICATION ---
    function initAppScreens() {
        // On récupère toutes les images dans le conteneur .phone-screen
        const screens = document.querySelectorAll('.app-mockup-block .screen-image');

        // Sécurité si aucune image n'est trouvée
        if (screens.length <= 1) return;

        let currentIndex = 0;

        // Fonction pour changer d'image
        function showNextScreen() {
            // 1. On retire l'état 'active' de l'image actuelle
            screens[currentIndex].classList.remove('is-active');

            // 2. On calcule l'index suivant (en bouclant si on arrive à la fin)
            currentIndex = (currentIndex + 1) % screens.length;

            // 3. On ajoute l'état 'active' à la nouvelle image
            screens[currentIndex].classList.add('is-active');
        }

        // --- CYCLE AUTOMATIQUE ---
        // Exécute la fonction toutes les 5000 millisecondes (5 secondes)
        setInterval(showNextScreen, 5000);
    }

    // On lance le script au chargement de la page (compatible ViewTransitions)
    document.addEventListener('astro:page-load', initAppScreens);
</script>

<style>
    :global(body) { background-color: #e8e8e8; margin: 0; padding: 0; }

    .bento-style {
        background-color: #ffffff;
        border-radius: 18px;
        border: 1px solid rgba(40, 50, 118, 0.08);
    }

    /* 🛡️ LE FIX STRUCTUREL 🛡️ */
    .hero-section {
        width: 100vw;
        /* Hauteur exacte : 100% de l'écran - 20px (pour laisser 10px de marge top/bottom) */
        height: calc(100vh - 20px);
        padding: 0 10px;
        margin-top: 10px;
        margin-bottom: 10px; /* Tes 10px du bas sont de retour ! */
        box-sizing: border-box;
    }

    .hero-container {
        width: 100%;
        height: 100%; /* Prend exactement la place de la section */
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* --- TEXTE EN HAUT --- */
    .hero-text {
        text-align: center;
        max-width: 800px;
        z-index: 10;
        margin-top: 12vh;
        margin-bottom: 40px; /* Tu peux changer ça sans rien casser ! */
    }

    .hero-text h1 {
        font-size: 3.5rem;
        color: #283276;
        margin: 0 0 24px 0;
        line-height: 1.1;
        letter-spacing: -0.05em;
    }

    .hero-text p {
        font-size: 1.2rem;
        color: rgba(40, 50, 118, 0.7);
        line-height: 1.5;
        margin: 0;
    }

    /* --- ZONE DES BUS EN BAS --- */
    .buses-area {
        flex-grow: 1;
        width: 100%;
        position: relative;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .module {
        position: absolute;
        bottom: -25%; /* Laisse les roues dépasser un poil en bas du Bento */
        width: 80vw; /* Taille du bus. Tu peux jouer avec ce chiffre (ex: 50vw ou 70vw) sans rien casser ! */
        max-width: 1200px;
        min-width: 700px;
    }

    .module img {
        width: 100%;
        height: auto;
        display: block;
    }

    /* --- MODULE DE DROITE (Devant et fixe) --- */
    .module-right {
        left: 50%; /* Son bord GAUCHE commence au centre exact de l'écran */
        z-index: 2;
    }

    /* --- MODULE DE GAUCHE (S'accroche derrière) --- */
    .module-left {
        right: 50%; /* Son bord DROIT s'arrête au centre exact de l'écran */
        transform: translateX(-50vw); /* Part de loin à gauche hors de l'écran */
        transition: transform 2s cubic-bezier(0.25, 1, 0.5, 1);
        z-index: 1;
    }

    .hero-container.is-merged .module-left {
        /* Il vient se coller parfaitement. Le 1px c'est pour éviter une micro-ligne blanche entre les deux images selon les écrans */
        transform: translateX(1px);
    }

    @media (max-width: 768px) {
        .hero-text h1 { font-size: 2.5rem; }
        .module { width: 120vw; min-width: 600px; bottom: 0; }
    }

    /* --- SECTION 2 : PRÉSENTATION DES MODULES --- */
    .modules-presentation-section {
        width: 100vw;
        padding: 0 10px;
        margin-bottom: 10px; /* On garde la règle des 10px d'espacement en bas */
        box-sizing: border-box;
    }

    .modules-bento {
        display: grid;
        grid-template-columns: 1fr 1fr; /* 50% gauche, 50% droite */
        gap: 60px; /* Espace entre le texte et la liste */
        padding: 60px !important; /* Un bon padding interne pour faire respirer */
        align-items: center;
    }

    .modules-text h2 {
        font-size: 2.5rem;
        color: #283276;
        margin: 0 0 24px 0;
        letter-spacing: -0.03em;
    }

    .modules-text p {
        font-size: 1.15rem;
        color: rgba(40, 50, 118, 0.7);
        line-height: 1.6;
        margin: 0;
    }

    /* La liste stylisée à droite */
    .modules-list {
        display: flex;
        flex-direction: column;
        gap: 16px; /* Espace entre chaque type de bus */
    }

    .module-type {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        background-color: #f8f9fa; /* Petit fond gris très clair */
        border: 1px solid rgba(40, 50, 118, 0.08);
        border-radius: 12px;
        transition: border-color 0.2s ease;
    }

    .module-type:hover {
        border-color: rgba(40, 50, 118, 0.3); /* Effet très léger au survol */
    }

    .module-name {
        font-weight: 600;
        color: #283276;
        font-size: 1.1rem;
    }

    .module-detail {
        font-size: 0.95rem;
        color: rgba(40, 50, 118, 0.5);
    }

    /* Responsive */
    @media (max-width: 900px) {
        .modules-bento {
            grid-template-columns: 1fr; /* Passe en 1 colonne sur petit écran */
            gap: 40px;
            padding: 40px !important;
        }
    }

    /* --- SECTION 3 : ADAPTÉ AUX BESOINS --- */
    .needs-section {
        width: 100vw;
        padding: 0 10px; /* Aligné avec le Hero ! */
        margin-bottom: 10px; /* Règle des 10px vers le bas */
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 10px; /* L'espace entre l'en-tête et ta grille d'images */
    }

    .needs-header {
        text-align: center;
        padding: 60px !important;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .needs-header h2 {
        font-size: 2.5rem;
        color: #283276;
        margin: 0 0 16px 0;
        letter-spacing: -0.03em;
    }

    .needs-header p {
        font-size: 1.15rem;
        color: rgba(40, 50, 118, 0.7);
        max-width: 800px;
        margin: 0;
        line-height: 1.5;
    }

    @media (max-width: 900px) {
        .needs-header { padding: 40px !important; }
    }

    /* --- SECTION 4 : L'APPLICATION --- */
    .app-section {
        width: 100vw;
        padding: 0 10px;
        margin-bottom: 10px;
        box-sizing: border-box;
    }

    .app-bento {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        padding: 60px !important; /* On remet un padding propre et égal partout */
        background-color: #ffffff;
        border-radius: 18px;
        border: 1px solid rgba(40, 50, 118, 0.08);
        overflow: hidden; /* La fameuse guillotine qui va couper le téléphone */
        align-items: center; /* Centre le texte verticalement */
    }

    /* --- LE TÉLÉPHONE --- */
    .app-mockup-block {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 400px; /* Garantit qu'on voit au moins la moitié haute du téléphone */
        display: flex;
        justify-content: center;
    }

    .phone-skeleton {
        position: absolute; /* Sort le téléphone du flux, il n'étire plus la boîte ! */
        top: 0; /* On l'accroche en haut de sa colonne */
        width: 320px;
        height: 693px;
        background-color: #000000;
        border-radius: 40px;
        border: 12px solid #000000;
        box-sizing: content-box;
    }

    /* L'écran qui contient les images */
    .phone-screen {
        width: 100%;
        height: 100%;
        background-color: #ffffff;
        border-radius: 28px;
        overflow: hidden;
        position: relative;
        border: 2px solid rgba(255, 255, 255, 0.1);
    }

    .screen-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 1s ease-in-out;
        z-index: 1;
    }

    .screen-image.is-active { opacity: 1; z-index: 2; }

    .phone-btn { position: absolute; background-color: #1a1a1a; border-radius: 2px; }
    .phone-btn-volume { width: 4px; height: 100px; left: -16px; top: 120px; box-shadow: -2px 0 2px rgba(0,0,0,0.5); }
    .phone-btn-power { width: 4px; height: 60px; right: -16px; top: 140px; box-shadow: 2px 0 2px rgba(0,0,0,0.5); }

    /* --- LE TEXTE --- */
    .app-text-block {
        max-width: 500px;
        /* Plus besoin des paddings bidouillés, la boîte gère tout seule */
    }

    .app-text-block h2 { font-size: 2.5rem; color: #283276; margin: 0 0 24px 0; letter-spacing: -0.03em; }
    .app-text-block p { font-size: 1.15rem; color: rgba(40, 50, 118, 0.7); line-height: 1.6; margin: 0 0 40px 0; }

    /* Responsive */
    @media (max-width: 1024px) {
        .app-bento { gap: 40px; padding: 40px !important; }
        .app-mockup-block { min-height: 350px; }
        .phone-skeleton { width: 280px; height: 606px; }
    }

    @media (max-width: 768px) {
        .app-bento {
            grid-template-columns: 1fr;
            text-align: center;
        }
        .app-text-block { margin: 0 auto; }
        .app-text-block h2 { font-size: 2rem; }

        /* Sur mobile, on affiche le téléphone en entier, ou coupé en bas ? */
        /* Si tu veux qu'il soit aussi coupé sur mobile : */
        .app-mockup-block { min-height: 450px; }
        .phone-skeleton { top: 40px; } /* Laisse un peu de place au-dessus */
    }

    /* --- SECTION 5 : BÉNÉFICES 1x4 --- */
    .horizontal-benefits-section {
        width: 100vw;
        padding: 0 10px;
        margin-bottom: 10px;
        box-sizing: border-box;
    }

    .horizontal-benefits-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        width: 100%;
    }

    /* 🔴 LA CORRECTION MAGIQUE : On force les enfants (les BentoItem) à rester dans 1 seule case */
    .horizontal-benefits-grid > :global(*) {
        grid-column: span 1 !important;
    }

    .horizontal-benefits-grid :global(.icon-text-container) {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        justify-content: center;
        height: 100%;
        min-height: 180px;
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
        .horizontal-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
        .horizontal-benefits-grid { grid-template-columns: 1fr; }
    }
</style>