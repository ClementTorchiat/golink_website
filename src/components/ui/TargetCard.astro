---
// src/components/ui/TargetCard.astro
interface Props {
    title: string;
    description?: string;
    color: 'yellow' | 'purple' | 'darkblue' | 'lightblue';
    col?: number;
    imageUrl?: string; // AJOUT : On déclare que le composant peut recevoir une URL
}

const {
    title,
    description = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore.",
    color,
    col = 4,
    imageUrl // AJOUT : On récupère l'URL envoyée par index.astro
} = Astro.props;

const bgColors = {
    yellow: '#FFEC83',
    purple: '#E5BDED',
    darkblue: '#283276',
    lightblue: '#7E8DD2'
};

const textColors = {
    yellow: '#283276',
    purple: '#283276',
    darkblue: '#ffffff',
    lightblue: '#ffffff'
};

// AJOUT : Si on ne donne pas d'imageUrl, on essaie de deviner le nom du fichier
const finalImage = imageUrl || `/images/${title.toLowerCase()}.jpg`;
---

<div
        class="target-card"
        style={`grid-column: span ${col}; --card-bg: ${bgColors[color]}; --card-text: ${textColors[color]};`}
>
    <img src={finalImage} alt={title} class="bg-image" />

    <div class="content-overlay">
        <h3>{title}</h3>
        <div class="description-wrapper">
            <div class="description-inner">
                <p>{description}</p>
            </div>
        </div>
    </div>
</div>

<style>
    .target-card {
        position: relative;
        border-radius: 18px;
        overflow: hidden;
        height: 400px;
        border: 1px solid rgba(40, 50, 118, 0.08);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        background-color: #f0f0f0; /* Fond de secours */
    }

    /* MODIFICATION : On adapte le style pour une vraie image */
    .bg-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; /* L'image remplit tout le cadre sans se déformer */
        z-index: 1;
        transition: transform 0.5s ease;
    }

    .content-overlay {
        position: relative;
        z-index: 2;
        background-color: var(--card-bg);
        color: var(--card-text);
        padding: 24px;
        transition: padding 0.3s ease;
    }

    h3 {
        margin: 0;
        font-size: 1.5rem;
        font-family: 'Funnel Display', sans-serif;
    }

    .description-wrapper {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .description-inner {
        overflow: hidden;
    }

    p {
        margin: 12px 0 0 0;
        font-size: 0.95rem;
        line-height: 1.4;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .target-card:hover .bg-image {
        transform: scale(1.05);
    }

    .target-card:hover .description-wrapper {
        grid-template-rows: 1fr;
    }

    .target-card:hover p {
        opacity: 1;
    }

    /* --- RESPONSIVE : Affichage permanent sur Tablettes & Mobiles --- */
    @media (max-width: 1024px) {
        .target-card {
            grid-column: span 6 !important;
        }

        /* On force la description à être ouverte */
        .description-wrapper {
            grid-template-rows: 1fr;
        }

        /* On force le texte à être visible */
        p {
            opacity: 1;
        }

        /* Optionnel : on désactive le zoom de l'image pour éviter les bugs au clic */
        .target-card:hover .bg-image {
            transform: none;
        }
    }

    @media (max-width: 768px) {
        .target-card {
            grid-column: span 12 !important;
            height: auto;
            /* 🔴 L'ASTUCE : On force 220px d'espace vide en haut pour garantir que l'image soit vue */
            padding-top: 220px;
            min-height: auto; /* Plus besoin de min-height avec le padding */
        }
    }
</style>