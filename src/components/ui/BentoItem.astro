---
// src/components/ui/BentoItem.astro

interface Props {
    col?: number;
    row?: number;
    accent?: 'none' | 'yellow' | 'purple' | 'darkblue' | 'lightblue';
}

const { col = 12, row = 1, accent = 'none' } = Astro.props;

// Tes couleurs de charte
const accentColors = {
    none: 'transparent',
    yellow: '#FFEC83',
    purple: '#E5BDED',
    darkblue: '#283276',
    lightblue: '#7E8DD2'
};
---

<div
        class="bento-item"
        style={`
        grid-column: span ${col};
        grid-row: span ${row}; 
        /* On passe la couleur à notre CSS en variable ! */
        --accent-color: ${accentColors[accent]};
    `}
>
    <slot />
</div>

<style>
    .bento-item {
        background-color: #ffffff; /* Fond monotone toujours blanc */
        border-radius: 18px; /* Angles Worklouder */
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;

        /* La bordure fine très pro */
        border: 1px solid rgba(40, 50, 118, 0.08);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    /* LE SECRET DE L'OPTION 3 : La ligne de couleur en haut */
    .bento-item::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 6px; /* Épaisseur de la ligne d'accentuation */
        background-color: var(--accent-color);
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .bento-item { grid-column: span 6 !important; }
    }
    @media (max-width: 768px) {
        .bento-item { grid-column: span 12 !important; }
    }
</style>