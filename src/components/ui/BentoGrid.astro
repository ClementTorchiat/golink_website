---
// src/components/ui/BentoGrid.astro
---
<div class="bento-grid">
    <slot />
</div>

<style>
    .bento-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 10px;
        width: 100%; /* Il remplit simplement son conteneur */
    }

    @media (max-width: 1024px) { .bento-grid { grid-template-columns: repeat(6, 1fr); } }
    @media (max-width: 768px) { .bento-grid { display: flex; flex-direction: column; } }
</style>