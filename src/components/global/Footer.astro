---
// src/components/global/Footer.astro
import Button from './Button.astro';
---

<footer class="site-footer">
    <div class="footer-bento">

        <div class="footer-main">
            <div class="cta-stack">
                <h2>Prêt à repenser<br>la mobilité urbaine ?</h2>
                <p>GOLink est actuellement en phase de concept. Suivez notre évolution vers les villes de demain.</p>
            </div>
            <div class="action-buttons">
                <Button href="/fonctionnement" variant="primary">Découvrir la techno</Button>
            </div>
        </div>

        <div class="footer-nav">
            <h4>Sitemap</h4>
            <ul>
                <li><a href="/">Accueil</a></li>
                <li><a href="/fonctionnement">Fonctionnement</a></li>
                <li><a href="/avantages">Avantages</a></li>
                <li><a href="/faq">FAQ</a></li>
                <li><a href="/contact">Contact & Équipe</a></li>
            </ul>
        </div>

        <div class="footer-contact">
            <h4>Contactez l'équipe</h4>
            <div class="emails-list">
                <a href="mailto:clement.torchiat@edu.univ-fcomte.fr">clement.torchiat@edu.univ-fcomte.fr</a>
                <a href="mailto:aline.rose@edu.univ-fcomte.fr">aline.rose@edu.univ-fcomte.fr</a>
                <a href="mailto:ambre.monamy@edu.univ-fcomte.fr">ambre.monamy@edu.univ-fcomte.fr</a>
                <a href="mailto:tania.andre@edu.univ-fcomte.fr">tania.andre@edu.univ-fcomte.fr</a>
            </div>
        </div>

        <div class="copyright">
            <p>Ce projet a été réalisé dans le cadre du Master 1 PSM (Produits et Services Multimédia).</p>
            <p>Projet Étudiant – Université Marie et Louis Pasteur, Montbéliard.</p>
        </div>

    </div>
</footer>

<style>
    /* Le conteneur du footer avec exactement 10px partout en bas */
    .site-footer {
        width: 100vw;
        padding: 0 10px 10px 10px;
        box-sizing: border-box;
    }

    /* La Bento blanche qui s'aligne parfaitement avec le Hero */
    .footer-bento {
        width: 100%;
        background-color: #ffffff;
        border: 1px solid rgba(40, 50, 118, 0.08); /* Bordure technique standard */
        border-radius: 18px;
        padding: 60px; /* Padding généreux pour l'équilibre */

        display: grid;
        grid-template-columns: 2fr 1fr; /* Structure Bento standard (Gauche large, Droite fine) */
        grid-template-rows: auto auto; /* Deux lignes principales */
        gap: 40px;
    }

    /* LE BLOC PRINCIPAL CORRIGÉ (STACKÉ) */
    .footer-main {
        grid-column: 1 / 2;
        grid-row: 1 / 2; /* Désormais seulement sur la première ligne */
        display: flex;
        flex-direction: column;
        justify-content: flex-start; /* 🔴 Plus de space-between */
        gap: 32px; /* Espacement fixe entre le texte et le bouton */
    }

    .cta-stack {
        display: flex;
        flex-direction: column;
        gap: 16px; /* Espacement entre le titre et le texte */
    }

    .footer-main h2 {
        color: #283276;
        font-size: 3rem;
        margin: 0;
        line-height: 1.1;
        letter-spacing: -0.03em;
    }

    .footer-main p {
        color: rgba(40, 50, 118, 0.7); /* Texte légèrement transparent */
        font-size: 1.1rem;
        max-width: 400px; /* Conserve le formatage du texte */
        margin: 0;
        line-height: 1.5;
    }

    /* LES PETITS TITRES DES COLONNES */
    h4 {
        margin: 0 0 16px 0;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(40, 50, 118, 0.4); /* Gris technique */
    }

    /* LA NAVIGATION (Top-Right) */
    .footer-nav {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
    }

    .footer-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .footer-nav a {
        color: #283276;
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    .footer-nav a:hover {
        text-decoration: underline;
    }

    /* LE COPYRIGHT CORRIGÉ (Bottom-Left) */
    .copyright {
        grid-column: 1 / 2;
        grid-row: 2 / 3; /* Désormais ancré en bas à gauche */
        align-self: flex-end; /* Force l'ancrage en bas du bento */
        text-align: left;
    }

    .copyright p {
        margin: 4px 0;
        color: rgba(40, 50, 118, 0.5);
        font-size: 0.9rem;
    }

    /* LA PARTIE CONTACT CORRIGÉE (Bottom-Right) */
    .footer-contact {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
        align-self: flex-end; /* Force l'ancrage en bas du bento */
        border-top: none; /* 🔴 Suppression de la ligne fine technique */
        padding-top: 0;
    }

    .emails-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .emails-list a {
        color: #283276;
        text-decoration: none;
        font-size: 0.85rem; /* Plus petit pour les mails longs */
        font-weight: 500;
        transition: opacity 0.2s ease;
        opacity: 0.6;
    }

    .emails-list a:hover {
        opacity: 1;
        text-decoration: underline;
    }

    /* Responsive Mobile */
    @media (max-width: 768px) {
        .footer-bento {
            grid-template-columns: 1fr;
            gap: 32px;
            padding: 24px;
        }
        /* Pile mobile classique : Main -> Nav -> Contact -> Copyright */
        .footer-main { grid-column: 1 / 2; grid-row: 1 / 2; }
        .footer-nav { grid-column: 1 / 2; grid-row: 2 / 3; }
        .footer-contact { grid-column: 1 / 2; grid-row: 3 / 4; align-self: flex-start; text-align: left;}
        .copyright { grid-column: 1 / 2; grid-row: 4 / 5; align-self: flex-start; }

        .footer-main h2 { font-size: 2rem; }
        .emails-list a { font-size: 0.75rem; }
    }
</style>