---
// src/components/global/Footer.astro
import Button from './Button.astro';
---

<footer class="site-footer">
    <div class="footer-bento">

        <div class="footer-main">
            <h2>Prêt à repenser<br>la mobilité urbaine ?</h2>
            <p>GOLink est actuellement en phase de concept. Suivez notre évolution vers les villes de demain.</p>
            <div class="action-buttons">
                <Button href="/fonctionnement" variant="primary">Découvrir la techno</Button>
            </div>
        </div>

        <div class="footer-nav">
            <h4>Sitemap</h4>
            <ul>
                <li><a href="/">Accueil</a></li>
                <li><a href="/fonctionnement">Fonctionnement</a></li>
                <li><a href="/avantages">Avantages</a></li>
                <li><a href="/faq">FAQ</a></li>
            </ul>
        </div>

        <div class="footer-legal">
            <div class="contact">
                <h4>Contact</h4>
                <a href="mailto:hello@golink.fr">hello@golink.fr</a>
            </div>
            <div class="copyright">
                <p>&copy; 2026 GOLink.</p>
                <p>Projet modulaire.</p>
            </div>
        </div>

    </div>
</footer>

<style>
    /* Le conteneur du footer avec exactement 10px partout en bas */
    .site-footer {
        width: 100vw;
        padding: 0 10px 10px 10px;
        box-sizing: border-box;
    }

    /* La Bento blanche qui s'aligne parfaitement avec le Hero */
    .footer-bento {
        width: 100%; /* S'étire à 100% de l'espace disponible (moins les 10px de padding du parent) */
        background-color: #ffffff;
        border: 1px solid rgba(40, 50, 118, 0.08); /* Bordure technique standard */
        border-radius: 18px;
        padding: 40px;

        display: grid;
        grid-template-columns: 2fr 1fr;
        grid-template-rows: auto auto;
        gap: 40px;
    }

    /* LE BLOC PRINCIPAL */
    .footer-main {
        grid-column: 1 / 2;
        grid-row: 1 / 3;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .footer-main h2 {
        color: #283276;
        font-size: 3rem;
        margin: 0 0 16px 0;
        line-height: 1.1;
        letter-spacing: -0.03em;
    }

    .footer-main p {
        color: rgba(40, 50, 118, 0.7); /* Texte légèrement transparent */
        font-size: 1.1rem;
        max-width: 400px;
        margin: 0 0 32px 0;
        line-height: 1.5;
    }

    /* LES PETITS TITRES DES COLONNES */
    h4 {
        margin: 0 0 16px 0;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(40, 50, 118, 0.4); /* Gris technique */
    }

    /* LA NAVIGATION */
    .footer-nav {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
    }

    .footer-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .footer-nav a {
        color: #283276;
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    .footer-nav a:hover {
        color: #FFEC83; /* Accent jaune au survol */
    }

    /* LA PARTIE LÉGALE / CONTACT */
    .footer-legal {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 32px;
        border-top: 1px solid rgba(40, 50, 118, 0.08); /* Ligne grise fine */
        padding-top: 24px;
    }

    .contact a {
        color: #283276;
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 500;
    }

    .contact a:hover {
        text-decoration: underline;
    }

    .copyright p {
        margin: 4px 0;
        color: rgba(40, 50, 118, 0.5);
        font-size: 0.9rem;
    }

    /* Responsive Mobile */
    @media (max-width: 768px) {
        .footer-bento {
            grid-template-columns: 1fr;
            gap: 32px;
            padding: 24px;
        }
        .footer-main { grid-column: 1 / 2; grid-row: 1 / 2; }
        .footer-nav { grid-column: 1 / 2; grid-row: 2 / 3; }
        .footer-legal { grid-column: 1 / 2; grid-row: 3 / 4; }
        .footer-main h2 { font-size: 2rem; }
    }
</style>