---
// src/components/global/Header.astro
const currentPath = Astro.url.pathname;
---

<header class="site-header">
    <div class="header-container" id="header-container">

        <div class="top-row">
            <a href="/" class="logo">GOLink</a>
            <button class="burger-btn" id="burger-btn" aria-label="Ouvrir le menu">
                <svg class="icon-burger" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 6H20M4 12H20M4 18H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>

        <nav class="pill-nav">
            <div class="active-pill-bg"></div>

            <ul class="nav-links">
                <li><a href="/" class={currentPath === "/" ? "active" : ""}>Accueil</a></li>
                <li><a href="/fonctionnement" class={currentPath === "/fonctionnement" ? "active" : ""}>Fonctionnement</a></li>
                <li><a href="/avantages" class={currentPath === "/avantages" ? "active" : ""}>Avantages</a></li>
                <li><a href="/faq" class={currentPath === "/faq" ? "active" : ""}>FAQ</a></li>
                <li><a href="/contact" class={currentPath === "/contact" ? "active" : ""}>Contact</a></li>
            </ul>
        </nav>

        <div class="btn-col">
            <a href="#download" class="download-app">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 15V3M12 15L8 11M12 15L16 11M3 18C3 19.1046 3.89543 20 5 20H19C20.1046 20 21 19.1046 21 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Télécharger l'app
            </a>
        </div>

    </div>
</header>

<style>
    /* --- BASE & DESKTOP --- */
    .site-header {
        font-family: 'Funnel Sans', sans-serif;
        padding: 20px 10px; /* Padding global du header */
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
    }

    .header-container {
        max-width: 1380px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 10px;
    }

    .top-row { display: flex; justify-content: flex-start; align-items: center; }
    .btn-col { display: flex; justify-content: flex-end; }

    .burger-btn { display: none; } /* Caché sur Desktop */

    .logo {
        font-family: 'Funnel Display', sans-serif;
        font-weight: bold;
        font-size: 1.25rem;
        color: #000000;
        text-decoration: none;
        letter-spacing: -0.05em;
    }

    .pill-nav {
        position: relative;
        backdrop-filter: blur(10px);
        background-color: rgba(128, 128, 128, 0.1);
        border-radius: 18px;
        padding: 3px;
        display: inline-flex;
    }

    .nav-links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        position: relative;
        z-index: 2;
    }

    .nav-links a {
        text-decoration: none;
        color: rgba(0, 0, 0, 0.6);
        padding: 8px 16px;
        border-radius: 18px;
        font-weight: 500;
        font-size: 0.9rem;
        transition: color 0.2s ease;
        display: block;
    }

    .active-pill-bg {
        position: absolute;
        top: 3px;
        bottom: 3px;
        left: 0;
        background-color: #FFEC83;
        border-radius: 14px;
        z-index: 1;
        transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        opacity: 0;
    }

    .nav-links a.active { color: #000000; }

    .download-app {
        background-color: #283276;
        color: #FFFFFF;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 18px;
        font-weight: 600;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: transform 0.2s ease;
    }
    .download-app:hover { transform: translateY(-1px); }

    /* --- RESPONSIVE MOBILE --- */
    @media (max-width: 768px) {
        .site-header {
            padding: 16px; /* Les fameux 10px de marge globale */
        }

        /* 🔴 La Pilule Blur s'applique maintenant au conteneur entier */
        .header-container {
            display: flex;
            flex-direction: column;
            padding: 0;
            backdrop-filter: blur(15px);
            background-color: rgba(255, 255, 255, 0.6); /* Légèrement plus blanc pour la lisibilité plein écran */
            border: 1px solid rgba(40, 50, 118, 0.08);
            border-radius: 18px;
            height: 56px; /* Hauteur fixe demandée */
            overflow: hidden;
            transition: height 0.5s cubic-bezier(0.25, 1, 0.5, 1), background-color 0.5s ease;
        }

        /* État "Menu Ouvert" */
        .header-container.is-open {
            height: calc(100vh - 20px); /* Prend tout l'écran moins la marge */
            background-color: rgba(255, 255, 255, 0.85); /* Plus opaque quand ouvert pour lire les liens */
        }

        .top-row {
            height: 56px; /* Garantit que la barre du haut fait pile 56px */
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            box-sizing: border-box;
            flex-shrink: 0; /* Empêche l'écrasement */
        }

        /* Bouton Burger */
        .burger-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            background: none;
            border: none;
            color: #283276;
            cursor: pointer;
            padding: 8px;
            margin-right: -8px; /* Compense le padding pour aligner à droite */
        }

        .icon-close { display: none; }

        .header-container.is-open .icon-burger { display: none; }
        .header-container.is-open .icon-close { display: block; }

        /* On désactive les styles "Pilule" desktop de la Nav */
        .pill-nav {
            background: none;
            backdrop-filter: none;
            border-radius: 0;
            padding: 0;
            display: flex;
            width: 100%;
            flex-grow: 1; /* Prend l'espace restant */
            justify-content: center; /* Centre verticalement */

            /* Animations d'apparition */
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease;
        }
        .header-container.is-open .pill-nav {
            opacity: 1;
            visibility: visible;
            transition-delay: 0.2s; /* Léger délai le temps que ça s'ouvre */
        }

        .active-pill-bg { display: none; } /* Plus de surlignage jaune sur mobile */

        .nav-links {
            flex-direction: column;
            align-items: center;
            gap: 30px; /* Grand espace entre les liens */
            width: 100%;
        }

        .nav-links a {
            font-size: 1.8rem; /* Gros liens bien lisibles */
            font-family: 'Funnel Display', sans-serif;
            color: #283276;
            padding: 10px;
        }

        /* Bouton Télécharger tout en bas */
        .btn-col {
            display: flex;
            justify-content: center;
            padding: 20px;
            flex-shrink: 0;

            /* Animations d'apparition */
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease;
        }
        .header-container.is-open .btn-col {
            opacity: 1;
            visibility: visible;
            transition-delay: 0.3s;
        }

        .download-app {
            width: 100%;
            justify-content: center;
            padding: 16px;
            font-size: 1.1rem;
        }
    }
</style>

<script>
    function initNav() {
        // --- 1. LOGIQUE DESKTOP (Pilule) ---
        const nav = document.querySelector('.pill-nav');
        const pill = document.querySelector('.active-pill-bg') as HTMLElement;
        const links = document.querySelectorAll('.nav-links a');

        // On n'active l'animation de la pilule que sur Desktop (> 768px)
        if (nav && pill && window.innerWidth > 768) {
            let activeLink = document.querySelector('.nav-links a.active') as HTMLElement;
            if (activeLink) {
                const movePillTo = (target: HTMLElement) => {
                    const navRect = nav.getBoundingClientRect();
                    const targetRect = target.getBoundingClientRect();
                    pill.style.width = `${targetRect.width}px`;
                    pill.style.transform = `translateX(${targetRect.left - navRect.left}px)`;
                };
                pill.style.transition = 'none';
                movePillTo(activeLink);
                pill.style.opacity = '1';
                void pill.offsetWidth;
                pill.style.transition = 'transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), width 0.3s cubic-bezier(0.25, 1, 0.5, 1)';

                links.forEach(link => {
                    link.addEventListener('mouseenter', (e) => movePillTo(e.target as HTMLElement));
                });
                nav.addEventListener('mouseleave', () => movePillTo(activeLink));
            }
        }

        // --- 2. LOGIQUE MOBILE (Burger Menu) ---
        const burgerBtn = document.getElementById('burger-btn');
        const headerContainer = document.getElementById('header-container');

        if (burgerBtn && headerContainer) {
            burgerBtn.addEventListener('click', () => {
                headerContainer.classList.toggle('is-open');

                // Bloque le scroll du site derrière le menu ouvert
                if (headerContainer.classList.contains('is-open')) {
                    document.body.style.overflow = 'hidden';
                } else {
                    document.body.style.overflow = '';
                }
            });

            // Ferme le menu si on clique sur un lien
            links.forEach(link => {
                link.addEventListener('click', () => {
                    headerContainer.classList.remove('is-open');
                    document.body.style.overflow = '';
                });
            });
        }
    }
    document.addEventListener('astro:page-load', initNav);
</script>