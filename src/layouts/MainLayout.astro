---
// src/layouts/MainLayout.astro
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/global/Footer.astro';

interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const {
    title = "GOLink",
    description = "Découvrez GoLink : le bus urbain autonome, 100 % électrique et modulable. Une mobilité sur-mesure, écologique et disponible 24h/24.",
    image = "/images/social-preview.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const socialImageURL = new URL(image, Astro.site || Astro.url.origin);
---

<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <ClientRouter />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Funnel+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

    <style is:global>
        /* CSS GLOBAL DUREI */
        * { box-sizing: border-box; }

        body {
            margin: 0;
            background-color: #F4F4F4; /* Fond monotone blanc */
            font-family: 'Funnel Sans', sans-serif;
            color: #283276;
        }

        /* Typographies */
        h1, h2, h3 { font-family: 'Funnel Display', sans-serif; font-weight: bold; }
    </style>
</head>
<body>
<slot name="header" />

<main id="main-content">
    <slot />
</main>

<Footer />
</body>
</html>

<style>
    /* GESTION DU CADRE GLOBAL DE 10PX */
    #main-content {
        /* Prêt pour tes éventuels réglages de padding globaux */
    }
</style>